# ===== 鉴权与对外地址 =====
# 部署脚本会自动生成；也可以手改后 docker compose restart
GATEWAY_TOKEN=change_me
# 用于把「播放 id」改写成网关地址；也可留空（按请求 Host 推断）
# 纯 IP 示例：http://1.2.3.4:18080
PUBLIC_BASE_URL=https://your.domain

# ===== 自动 HTTPS（仅 docker-compose.https.yml 用得到）=====
# 域名必须已解析到本机，且 80/443 已放通
DOMAIN=your.domain

# ===== 国内拉不到 Docker Hub 时可改镜像仓库 =====
# catvod-api.jar 是 Java 21 class，不能降到 17
# JDK_IMAGE=你的仓库/eclipse-temurin:21-jdk-alpine
# JRE_IMAGE=你的仓库/eclipse-temurin:21-jre-alpine
