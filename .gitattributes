# 统一换行：仓库内保持 LF，避免在 Linux 上脚本带 CRLF 无法执行
* text=auto eol=lf

*.sh           text eol=lf
*.java         text eol=lf
*.yml          text eol=lf
*.properties   text eol=lf
*.md           text eol=lf
*.txt          text eol=lf
Dockerfile     text eol=lf
Caddyfile      text eol=lf
*.template     text eol=lf
